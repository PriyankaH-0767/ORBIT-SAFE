# D-DATO Environment Configuration (Example)
# Copy this file to .env for local development overrides

# Core Application Settings (Phase P1)
APP_NAME=D-DATO
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
DEMO_MODE=true

# Database & Routing
DATABASE_URL=sqlite:///./d_dato.db
# Example for production PostgreSQL deployments:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/d_dato
API_V1_PREFIX=/api/v1

# Planning Defaults (Phase P2)
EPOCH_START_OFFSET_DAYS=1

ALTITUDE_MIN_KM=500
ALTITUDE_MAX_KM=600
ALTITUDE_STEP_KM=25

INCLINATION_MIN_DEG=97
INCLINATION_MAX_DEG=98
INCLINATION_STEP_DEG=0.5

RAAN_DEG=0
U0_DEG=0

DELAY_MIN_MINUTES=0
DELAY_MAX_MINUTES=720
DELAY_STEP_MINUTES=60

RAAN_DELAY_COUPLING_DEG_PER_MIN=0.25068
MAX_CANDIDATES=300

SCREENING_DAYS=3
SCREENING_MIN_DAYS=1
SCREENING_MAX_DAYS=7

REFERENCE_ALTITUDE_KM=550
REFERENCE_INCLINATION_DEG=97.5

DV_BUDGET_M_S=100

SPACECRAFT_MASS_KG=3
ISP_SECONDS=60

FUEL_WEIGHT=0.4
RISK_WEIGHT=0.6

DATA_SOURCE=celestrak

# Data Ingestion Fetch Etiquette Intervals (hours)
CELESTRAK_MIN_FETCH_INTERVAL_HOURS=2
SPACETRACK_MIN_FETCH_INTERVAL_HOURS=1

# Asynchronous Worker Concurrency (Phase P12)
WORKER_MAX_CONCURRENCY=1

# Conjunction Screening & Risk Parameters (Phases P8, P9)
SCREENING_COARSE_STEP_SECONDS=30.0
SCREENING_COARSE_THRESHOLD_KM=260.0
SCREENING_EVENT_THRESHOLD_KM=25.0
SCREENING_TCA_XTOL_SECONDS=0.01
SCREENING_TCA_MAX_ITERATIONS=100
SCREENING_MAX_EVENTS_PER_CANDIDATE=1000
SCREENING_DEBRIS_BATCH_SIZE=256
SCREENING_TIME_CHUNK_SECONDS=3600
SCREENING_PREFILTER_ALTITUDE_MARGIN_KM=300.0
SCREENING_INCLUDE_UNKNOWN_OBJECTS=true

RISK_PROXIMITY_WEIGHT=0.8
RISK_EVENT_COUNT_WEIGHT=0.2
RISK_EVENT_SATURATION_COUNT=5
RISK_DATA_AGE_ELEVATED_SECONDS=259200.0

# External Validation & SOCRATES Configuration (Phase P16)
# Live external queries are disabled by default; offline demo fixture/cache used
SOCRATES_ENABLED=false
SOCRATES_BASE_URL=
SOCRATES_TIMEOUT_SECONDS=10.0
VALIDATION_DEFAULT_TCA_TOLERANCE_SECONDS=300.0
VALIDATION_DEFAULT_MISS_DISTANCE_TOLERANCE_KM=5.0
